VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 'true' runs the board on seeded demo data and shows a "Демо-дані" badge.
# Anything else (including unset) uses Supabase.
#
# Keep this template on 'false'. A fresh clone should reach for the database and
# fail loudly on a missing key, rather than come up quietly on invented tickets
# that look exactly like a real service.
VITE_DEMO_MODE=false
